   "overrides": {},
   "translations": [
    {
     "translator": "Judith Gautier",
     "title": "L’auberge",
     "date": "1867",
     "note": "Selon Li Taï-Pé",
     "text": "Je me suis couché dans ce lit d’auberge;\nla lune, sur le parquet, jetait une lueur blanche,\nEt j’ai d’abord cru qu’il avait neigé sur le parquet.\nJ’ai levé la tête vers la lune claire, et j’ai songé aux pays que je vais parcourir et aux étrangers qu’il me faudra voir.\nPuis j’ai baissé la tête vers le parquet, et j’ai songé à mon pays et aux amis que je ne verrai plus."
    },
    {
     "translator": "Joseph Edkins",
     "title": "Thoughts on a Quiet Night",
     "date": "1890",
     "note": null,
     "text": "Before my couch the moon shines bright\nOr is it the snow that reflects this light?\nI see the moon when I raise my head\nI look down and my thoughts are homeward led."
    },
    {
     "translator": "Herbert Giles",
     "title": "Night Thoughts",
     "date": "1898",
     "note": null,
     "text": "I wake, and moonbeams play around my bed,\nGlittering like hoar-frost to my wondering eyes;\nUp towards the glorious moon I raise my head,\nThen lay me down, — and thoughts of home arise."
    }
   ]
  },
